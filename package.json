{
  "name": "@meltero/turnstile-react",
  "version": "1.0.0",
  "description": "A small, typed React wrapper for Cloudflare Turnstile's official client-side API.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.0.0",
    "jsdom": "^29.0.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.54.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Meltero/turnstile-react.git"
  },
  "bugs": {
    "url": "https://github.com/Meltero/turnstile-react/issues"
  },
  "homepage": "https://github.com/Meltero/turnstile-react#readme",
  "packageManager": "pnpm@10.11.0"
}
